{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "The launcher's own UI (terminal, toolbars, dividers). Local origin only.",
  "webviews": ["shell"],
  "permissions": [
    "core:default",
    "allow-launcher-info",
    "allow-debug-log",
    "allow-settings-set",
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-kill",
    "allow-pty-is-idle",
    "allow-herdr-dispatch",
    "allow-pane-bounds",
    "allow-pane-nav",
    "allow-pane-focus",
    "allow-pick-work-dir",
    "allow-deeplink-take",
    "allow-bridge-resolve"
  ]
}
