{
  "name": "@builderwars/launcher",
  "version": "0.1.0",
  "productName": "Builder Wars",
  "description": "Builder Wars desktop launcher",
  "license": "Apache-2.0",
  "author": "Rich Williams",
  "homepage": "https://builderwars.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwfresh/builderwars-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/rwfresh/builderwars-launcher/issues"
  },
  "desktopName": "builderwars-launcher.desktop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json && electron-vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "package": "electron-builder"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "node-gyp": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
