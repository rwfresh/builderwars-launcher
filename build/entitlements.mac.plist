<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for the Builder Wars launcher (mac.entitlements in electron-builder.yml).
     allow-jit / allow-unsigned-executable-memory: V8 in the main and helper processes.
     disable-library-validation: node-pty's pty.node and ad-hoc signed (unsigned CI) builds load without a Team ID match. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
